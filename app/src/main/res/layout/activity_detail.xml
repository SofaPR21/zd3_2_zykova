<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img3">

    <!-- Карточка с фильмом -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1AFFFFFF">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Постер и информация -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:id="@+id/detail_image"
                        android:layout_width="180dp"
                        android:layout_height="270dp"
                        android:scaleType="centerCrop"
                        android:background="#2a2a2a"
                        android:contentDescription="Постер фильма"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="24dp">

                        <TextView
                            android:id="@+id/detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/name_film"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:maxLines="3"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/detail_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/year"
                            android:textColor="@color/aquamarine"
                            android:textSize="20sp"
                            android:textStyle="italic"
                            android:layout_marginTop="12dp"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="16dp"
                            android:background="@drawable/year_badge" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Прогресс бар -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="20dp"
                    android:visibility="gone" />

                <!-- Заголовок описания -->
                <TextView
                    android:id="@+id/detail_description_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="О фильме"
                    android:textColor="@color/aquamarine"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Описание фильма -->
                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opisanie"
                    android:textColor="#E0E0E0"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="16dp"
                    android:background="@drawable/description_background" />

                <!-- Дополнительная информация -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/detail_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMDb: N/A"
                        android:textColor="#FFD700"
                        android:textSize="16sp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_background"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/detail_runtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Длительность: N/A"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_background" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/backButton"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/cardView"
        android:layout_marginStart="32dp"
        android:layout_marginTop="-25dp"
        android:text="‹ Назад"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/button"
        android:elevation="12dp" />

</RelativeLayout>